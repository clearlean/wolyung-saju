# 자기 Cloudflare 계정으로 직접 배포할 때만 필요합니다.
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋되지 않습니다.
#
# OpenAI Sites 로 배포한다면 이 파일은 없어도 됩니다. 값이 비어 있으면
# vite.config.ts 가 Sites 용 자리표시자를 그대로 씁니다.

# 배포 주소가 <이름>.<계정>.workers.dev 가 됩니다.
CF_WORKER_NAME=wolyung-saju

# `wrangler d1 create <이름>` 이 찍어 주는 값입니다.
CF_D1_DATABASE_NAME=wolyung-saju
CF_D1_DATABASE_ID=

# 커스텀 도메인. 쉼표로 여럿 적을 수 있습니다. 해당 도메인이 이 Cloudflare
# 계정의 영역(zone)으로 들어와 있어야 하고, 배포할 때 DNS 와 인증서까지
# 알아서 잡힙니다. 비워 두면 workers.dev 주소만 씁니다.
CF_CUSTOM_DOMAINS=

# 관리자 비밀번호는 여기 두지 마세요. 배포본에는 시크릿으로 넣습니다.
#   npx wrangler secret put ADMIN_PASSWORD --config dist/server/wrangler.json
